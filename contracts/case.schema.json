{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vagexa.local/schemas/case",
  "type": "object",
  "required": ["id", "reference", "title", "status", "data_classification", "opened_on"],
  "properties": {
    "id": { "type": "string" },
    "reference": { "type": "string" },
    "title": { "type": "string" },
    "status": { "type": "string", "enum": ["open", "closed"] },
    "data_classification": { "type": "string", "enum": ["synthetic", "official"] },
    "opened_on": { "type": "string" },
    "synthetic_batch_id": { "type": ["string", "null"] },
    "counts": { "type": "object" }
  },
  "additionalProperties": true
}
