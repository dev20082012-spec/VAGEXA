# Copy to .env and fill the bootstrap password at runtime. Do not commit .env.
# Local synthetic development only. Do not point this at operational data.

VAGEXA_DATA_MODE=synthetic
VAGEXA_DATABASE_URL=postgresql+psycopg://vagexa@127.0.0.1:5433/vagexa
VAGEXA_COOKIE_SECURE=false
VAGEXA_CORS_ORIGINS=http://127.0.0.1:5173
VAGEXA_LOG_LEVEL=info
VAGEXA_ENVIRONMENT=local
VAGEXA_STORAGE_DIR=var/storage
VAGEXA_STATIC_DIR=
VAGEXA_REQUIRE_DEMO=false
VAGEXA_UPLOAD_MAX_BYTES=25000000
VAGEXA_PASSIVE_INTEL=false

# Used only by `python -m vagexa.bootstrap` and `python -m vagexa.deploy_boot`.
# Leave blank here. Set them in the host environment. Do not commit a real password.
VAGEXA_BOOTSTRAP_USERNAME=
VAGEXA_BOOTSTRAP_PASSWORD=
VAGEXA_BOOTSTRAP_DISPLAY_NAME=Investigator
